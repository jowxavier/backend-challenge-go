POSTGRES_USER=wager
POSTGRES_PASSWORD=local_only
POSTGRES_DB=wager
POSTGRES_PORT=5432

DATABASE_URL=postgres://wager:local_only@localhost:5432/wager?sslmode=disable
TEST_DATABASE_URL=postgres://wager:local_only@localhost:5432/wager?sslmode=disable

REFERENCE_PENDING_TTL=24h

# Local SQS emulator; fake credentials only.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_OUTPUT_QUEUE=wager-events
SQS_CONSUMER_NAME=wager-financial-v1
SQS_CONCURRENCY=4
SQS_VISIBILITY_TIMEOUT=60s
SQS_PROCESSING_TIMEOUT=20s
SQS_LONG_POLL=20s
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_SECONDS=60

# Keycloak development realm/client mapping; auth is always enabled.
OIDC_ISSUER=http://localhost:8081/realms/wager
OIDC_AUDIENCE=wager-api
OIDC_INTERNAL_CLIENT=wallet-internal
OIDC_PROVIDER_CLIENTS='{"provider-a":"provider-a","provider-b":"provider-b"}'

TEST_SQS_ENDPOINT=http://localhost:4566
TEST_OIDC_ISSUER=http://localhost:8081/realms/wager
